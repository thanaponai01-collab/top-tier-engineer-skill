{
  "case": "safe-release-revert-is-not-rollback",
  "skill": "safe-release",
  "question": "a teammate's release whose notes say 'rollback: revert and redeploy'; the migration rebuilds the users table, so is the revert a real way back, and is the data the same shape after it?",
  "pass_score": 1.0,
  "planted": [
    {
      "id": "revert-breaks-signup",
      "what": "reverting the code leaves the migrated table behind (deploy.sh only migrates up), and the old sign-up code inserts no plan into a NOT NULL column with no default, so after the documented rollback every sign-up fails",
      "must_say_any": ["not null", "no default", "without a default", "default 'free'", "sign-ups fail", "signups fail", "signup fails", "sign-up fails", "signup would fail", "sign-up would fail", "signups would fail", "sign-ups would fail", "cannot sign up", "can't sign up", "breaks signup", "breaks sign-up"]
    },
    {
      "id": "unique-email-dropped",
      "what": "the table rebuild drops the UNIQUE constraint on users.email, so after the migration one email can hold several accounts",
      "must_say_any": ["unique"]
    },
    {
      "id": "down-loses-plans",
      "what": "once anyone upgrades, the down migration throws away who is on pro: rolling back after upgrades open loses paid plans (a point of no return), and the answer says so",
      "must_say_any": ["lose", "loses", "lost", "losing", "throws away", "discard", "point of no return", "one-way", "no longer reversible", "irreversible", "who paid", "who upgraded"]
    }
