      "RUNBOOK.md", "NOTES.md", "AGENTS.md", "VERIFY.md", "CHANGELOG.md", "scripts/*", "tools/*", ".gitignore",
      ".release/*", ".verify-state.json", ".verify-evidence/*", ".verify-state-cache/*"
