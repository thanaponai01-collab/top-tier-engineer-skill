# Shell scripts are executed by CI on Linux. core.autocrlf on a Windows checkout would
# otherwise hand bash CRLF line endings, which it reads as part of the command.
*.sh text eol=lf

# The tools are run by python3 on both platforms; keep them stable too.
*.py text eol=lf

# CI workflows carry bash `run:` blocks; same reason as *.sh.
*.yml text eol=lf

# A reference solution can ship a .verify-state.json whose tree signature hashes the files byte for
# byte; CRLF on a Windows checkout would make that frozen state read as stale.
evals/cases/**/reference/solution/** text eol=lf
